<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: opens the auto updater's settings (Updater.showSettings) -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="update_settings"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/update_settings">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="com.picoriseal.game"
            android:targetClass="com.picoriseal.game.PicoriActivity">
            <extra android:name="updateSettings" android:value="true" />
        </intent>
    </shortcut>
</shortcuts>
